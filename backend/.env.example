# Copy this file to .env and fill in your values (local dev only — on Render,
# set these as real environment variables in the dashboard instead).

CLAUDE_API_KEY=your_claude_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Google OAuth Client ID (Web application) — from Google Cloud Console >
# APIs & Services > Credentials. Must match REACT_APP_GOOGLE_CLIENT_ID used
# to build the frontend. Leave unset to keep the Google sign-in button hidden.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional — sends real password-reset emails via SMTP. With a Gmail account,
# SMTP_USER is the Gmail address and SMTP_PASS is a 16-char App Password
# (Google Account > Security > 2-Step Verification > App Passwords), NOT the
# normal login password. Leave unset and forgot-password still works — the
# API just returns the code directly instead of emailing it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# Only needed if you want to override the defaults baked into config.py:
# MONGO_URI=mongodb://localhost:27017
# SECRET_KEY=fyp_bug_detector_secret_2026
